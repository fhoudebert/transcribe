From f008d06d0342a9a388dbfcc4cbf9a4e616e4559d Mon Sep 17 00:00:00 2001
From: patch <patch@local>
Date: Mon, 20 Jul 2026 19:58:17 +0000
Subject: [PATCH] requirements.txt: marqueurs sys_platform sur les roues CUDA
 (Linux only)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Le gel a été produit par pip freeze sous Linux : il fige les roues CUDA
(nvidia-*, cuda-*, triton) que torch n'entraîne que sur Linux. Sous
Windows, nvidia-cufile n'a aucune distribution → l'installation échouait :
    ERROR: No matching distribution found for nvidia-cufile==1.15.1.6
Correctif : 19 lignes annotées « ; sys_platform == "linux" » — Linux
installe exactement le même gel qu'avant (98 paquets), Windows en ignore
les roues CUDA (79 paquets, torch CPU autosuffisant). Validé avec
packaging : les 98 lignes parsent, aucune roue CUDA retenue sous win32,
toutes conservées sous linux.

setup_venv_lang.bat : préfère py -3.12 (version du gel) puis py -3 avec
avertissement, avant le repli python.
---
 requirements.txt    | 43 ++++++++++++++++++++++++-------------------
 setup_venv_lang.bat | 19 +++++++++++++++----
 2 files changed, 39 insertions(+), 23 deletions(-)

diff --git a/requirements.txt b/requirements.txt
index ec12fa2..11c0934 100755
--- a/requirements.txt
+++ b/requirements.txt
@@ -1,3 +1,8 @@
+# Gel produit sous Linux (pip freeze).
+# Les roues CUDA (nvidia-*, cuda-*, triton) n'existent que pour Linux :
+# marquées ; sys_platform == "linux" pour être ignorées sous Windows,
+# où torch (CPU) est autosuffisant. Ne pas retirer ces marqueurs lors
+# d'un futur pip freeze : re-annoter de la même façon.
 altgraph==0.17.5
 annotated-doc==0.0.4
 annotated-types==0.7.0
@@ -15,9 +20,9 @@ click==8.4.1
 cloudpathlib==0.24.0
 confection==1.3.3
 ctranslate2==4.7.2
-cuda-bindings==13.3.1
-cuda-pathfinder==1.5.5
-cuda-toolkit==13.0.2
+cuda-bindings==13.3.1 ; sys_platform == "linux"
+cuda-pathfinder==1.5.5 ; sys_platform == "linux"
+cuda-toolkit==13.0.2 ; sys_platform == "linux"
 cymem==2.0.13
 emoji==2.15.0
 filelock==3.29.1
@@ -39,21 +44,21 @@ murmurhash==1.0.15
 mwt==0.9.2
 networkx==3.6.1
 numpy==2.4.6
-nvidia-cublas==13.1.1.3
-nvidia-cuda-cupti==13.0.85
-nvidia-cuda-nvrtc==13.0.88
-nvidia-cuda-runtime==13.0.96
-nvidia-cudnn-cu13==9.20.0.48
-nvidia-cufft==12.0.0.61
-nvidia-cufile==1.15.1.6
-nvidia-curand==10.4.0.35
-nvidia-cusolver==12.0.4.66
-nvidia-cusparse==12.6.3.3
-nvidia-cusparselt-cu13==0.8.1
-nvidia-nccl-cu13==2.29.7
-nvidia-nvjitlink==13.0.88
-nvidia-nvshmem-cu13==3.4.5
-nvidia-nvtx==13.0.85
+nvidia-cublas==13.1.1.3 ; sys_platform == "linux"
+nvidia-cuda-cupti==13.0.85 ; sys_platform == "linux"
+nvidia-cuda-nvrtc==13.0.88 ; sys_platform == "linux"
+nvidia-cuda-runtime==13.0.96 ; sys_platform == "linux"
+nvidia-cudnn-cu13==9.20.0.48 ; sys_platform == "linux"
+nvidia-cufft==12.0.0.61 ; sys_platform == "linux"
+nvidia-cufile==1.15.1.6 ; sys_platform == "linux"
+nvidia-curand==10.4.0.35 ; sys_platform == "linux"
+nvidia-cusolver==12.0.4.66 ; sys_platform == "linux"
+nvidia-cusparse==12.6.3.3 ; sys_platform == "linux"
+nvidia-cusparselt-cu13==0.8.1 ; sys_platform == "linux"
+nvidia-nccl-cu13==2.29.7 ; sys_platform == "linux"
+nvidia-nvjitlink==13.0.88 ; sys_platform == "linux"
+nvidia-nvshmem-cu13==3.4.5 ; sys_platform == "linux"
+nvidia-nvtx==13.0.85 ; sys_platform == "linux"
 onnxruntime==1.26.0
 packaging==26.2
 preshed==3.0.13
@@ -88,7 +93,7 @@ sympy==1.14.0
 thinc==8.3.13
 torch==2.12.0
 tqdm==4.68.1
-triton==3.7.0
+triton==3.7.0 ; sys_platform == "linux"
 typer==0.26.7
 typing-inspection==0.4.2
 typing_extensions==4.15.0
diff --git a/setup_venv_lang.bat b/setup_venv_lang.bat
index 9776783..305bfe1 100644
--- a/setup_venv_lang.bat
+++ b/setup_venv_lang.bat
@@ -18,10 +18,21 @@ set "SCRIPT_DIR=%~dp0"
 set "VENV=%SCRIPT_DIR%build\python\venv-windows"
 
 echo [1/4] Recherche de Python...
-where py >nul 2>nul
-if %errorlevel%==0 (
-    set "PYCMD=py -3"
-) else (
+rem Preference : Python 3.12, la version avec laquelle le gel de
+rem requirements.txt a ete produit et valide. Un Python plus recent peut
+rem manquer de roues precompilees pour certaines versions figees.
+set "PYCMD="
+py -3.12 --version >nul 2>nul && set "PYCMD=py -3.12"
+if not defined PYCMD (
+    py -3 --version >nul 2>nul && (
+        set "PYCMD=py -3"
+        echo [AVERTISSEMENT] Python 3.12 introuvable, utilisation de :
+        py -3 --version
+        echo                 En cas d'echec pip, installez Python 3.12 :
+        echo                 https://www.python.org/downloads/
+    )
+)
+if not defined PYCMD (
     where python >nul 2>nul || (
         echo [ERREUR] Python introuvable. Installez Python 3.12 depuis
         echo          https://www.python.org/downloads/ ^(cocher "py launcher"^)
-- 
