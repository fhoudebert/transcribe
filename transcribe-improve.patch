 #!/bin/bash
 # ============================================================
 #  soustitre.sh  —  Transcription audio -> SRT
-#  Usage : soustitre.sh <fichier> [base|medium|large] [yes|no]
+#  Usage : soustitre.sh <fichier> [base|medium|large] [yes|no] [src_lang|auto]
